    },
    "Programas": {
      "BaseUrl": "http://localhost:5122",
      "UsaServiceToken": true
    },
    "Plataforma": {
      "BaseUrl": "http://localhost:8080",
      "UsaServiceToken": true
    }
  },
  "Storage": {
    "Provider": "Local",
